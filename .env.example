# Placeholders only. local-stack/up.sh writes a working .env.local for you.
# With the Supabase CLI, copy the API URL and keys from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Planted bug: a service-role key must never have a NEXT_PUBLIC_ name. Notely does it anyway.
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
